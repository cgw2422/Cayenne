# --- required ---------------------------------------------------------------

# Postgres connection string.
# On Railway, reference the database service: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@localhost:5432/cayenne?schema=public"

# Session signing/hashing secret. Generate with: openssl rand -base64 48
AUTH_SECRET="replace-me"

# --- public origin ----------------------------------------------------------
# Used for share links and Open Graph image URLs.
#
# APP_URL is read at runtime and wins if set. On Railway you can skip it —
# RAILWAY_PUBLIC_DOMAIN is detected automatically.
# APP_URL="https://cayennedoit.com"

# Read at build time. Set this too so statically rendered pages (the landing
# page) carry the right Open Graph URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- optional ---------------------------------------------------------------

# Web-push VAPID keys, once reminder delivery is wired up.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""

# Allows the stand-in lifetime unlock button to work in production, before a
# real payment provider is connected. Leave unset for a real launch.
# ALLOW_DEV_UNLOCK="1"
