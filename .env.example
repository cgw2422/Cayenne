# Postgres connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/cayenne?schema=public"

# 32+ random bytes. Generate with: openssl rand -base64 48
AUTH_SECRET="replace-me"

# Public origin, used for share links and OG image URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: web-push VAPID keys for PWA reminders.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
