// Cayenne Do It — relational schema.
// Every domain concept gets real columns, relations and indexes; no JSON blobs.

generator client {
  provider      = "prisma-client-js"
  // "native" covers local development; the Debian target keeps the client
  // working on container hosts such as Railway, Render and Fly.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- identity --

enum Entitlement {
  FREE
  LIFETIME
}

/// How an account came by its entitlement. FREE accounts have none.
enum EntitlementSource {
  /// Bought it, through whatever provider `entitlementProvider` names.
  PAID
  /// Given it — beta testers, giveaways, community admins.
  COMPLIMENTARY
}

/// Who may do what. Authorization is decided from this column server-side on
/// every admin page, action and route; nothing is gated by hiding UI.
enum Role {
  USER
  PLATFORM_ADMIN
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String?
  displayName  String
  entitlement  Entitlement @default(FREE)
  entitledAt   DateTime?
  onboardedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  role Role @default(USER)

  /// Whether the entitlement was bought or given, and why. Only set alongside
  /// LIFETIME; cleared when it is revoked.
  entitlementSource   EntitlementSource?
  /// "stripe", "apple", "google", "manual" — whatever granted it.
  entitlementProvider String?            @db.VarChar(40)
  /// Why a complimentary account was comped. Admin-facing only.
  entitlementNote     String?            @db.VarChar(200)

  /// Set when an admin disables the account. A disabled account cannot sign in
  /// and its live sessions stop resolving.
  disabledAt DateTime?

  /// Set when an admin forces a password reset. The user keeps their password
  /// long enough to sign in once, then must choose a new one before going on.
  passwordResetAt DateTime?

  /// Last time this account made an authenticated request. Written at most once
  /// every 30 minutes, so it costs almost nothing on the read path.
  lastSeenAt DateTime?

  profile       Profile?
  accounts      Account[]
  sessions      Session[]
  entries       CayenneEntry[]
  userGoals     UserGoal[]
  measurements  Measurement[]
  journal       JournalEntry[]
  challenges    UserChallenge[]
  achievements  UserAchievement[]
  recipes       Recipe[]
  favorites     RecipeFavorite[]
  impressions   QuoteImpression[]
  notifications NotificationPreference?
  reminders     ReminderTime[]
  pushSubs      PushSubscription[]
  shareCards    ShareCard[]
  shareEvents   ShareEvent[]
  savedLines    SavedLine[]
  sharePhotos   SharePhoto[]
  feedback      Feedback[]
  adminActions  AdminAuditLog[]         @relation("AdminActor")
  actionsOnMe   AdminAuditLog[]         @relation("AdminTarget")

  @@index([createdAt])
  @@index([entitlement])
  @@index([lastSeenAt])
  @@index([entitledAt])
}

/// Present from day one so Google/Apple sign-in is a row, not a migration.
model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum Method {
  WATER
  TEA
  FOOD
  SHOT
  CAPSULE
  OTHER
}

enum Unit {
  TSP
  MG
  G
  CAPSULE
}

enum UnitSystem {
  IMPERIAL
  METRIC
}

model Profile {
  id            String     @id @default(cuid())
  userId        String     @unique
  avatarHue     Int        @default(8)
  unitSystem    UnitSystem @default(IMPERIAL)
  defaultMethod Method?
  defaultAmount Decimal?   @db.Decimal(8, 3)
  defaultUnit   Unit       @default(TSP)
  /// How many times a day the user intends to take cayenne.
  dosesPerDay   Int        @default(1)
  startedOn     DateTime   @db.Date
  timezone      String     @default("UTC")

  // Denormalised streak cache, recomputed on every entry write.
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  totalDays       Int       @default(0)
  lastLoggedOn    DateTime? @db.Date
  streakUpdatedAt DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The admin user list sorts on these, so they are indexed rather than
  /// recomputed per row.
  @@index([totalDays])
  @@index([currentStreak])
  @@index([lastLoggedOn])
}

// ------------------------------------------------------------------- goals --

/// Catalog of selectable personal goals. These are the *user's* goals — the app
/// never claims cayenne achieves them.
model Goal {
  id        String  @id @default(cuid())
  slug      String  @unique
  label     String
  icon      String
  sortOrder Int     @default(0)
  isSystem  Boolean @default(true)

  userGoals UserGoal[]
}

model UserGoal {
  id        String   @id @default(cuid())
  userId    String
  goalId    String
  createdAt DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal       Goal        @relation(fields: [goalId], references: [id], onDelete: Cascade)
  entryGoals EntryGoal[]

  @@unique([userId, goalId])
  @@index([userId])
}

// ----------------------------------------------------------------- logging --

model CayenneEntry {
  id        String   @id @default(cuid())
  userId    String
  takenAt   DateTime
  /// Local calendar day of `takenAt`, used for streaks and calendar marking.
  takenOn   DateTime @db.Date
  method    Method
  amount    Decimal  @db.Decimal(8, 3)
  unit      Unit     @default(TSP)
  /// 1 Terrible … 5 Great. Optional.
  mood      Int?
  notes     String?  @db.VarChar(2000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals EntryGoal[]

  @@index([userId, takenOn])
  @@index([userId, takenAt])
  /// Admin reporting rolls entries up by day across all users.
  @@index([takenOn])
}

/// Why the user took it — links an entry to the goals they picked at onboarding.
model EntryGoal {
  id         String @id @default(cuid())
  entryId    String
  userGoalId String

  entry    CayenneEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  userGoal UserGoal     @relation(fields: [userGoalId], references: [id], onDelete: Cascade)

  @@unique([entryId, userGoalId])
  @@index([userGoalId])
}

// ------------------------------------------------------ optional body data --

enum MeasurementKind {
  WEIGHT
  WAIST
  BLOOD_PRESSURE
  BLOOD_GLUCOSE
  CUSTOM
}

/// Private journal-style tracking. Never public, never attributed to cayenne.
model Measurement {
  id          String          @id @default(cuid())
  userId      String
  kind        MeasurementKind
  customLabel String?
  value       Decimal         @db.Decimal(10, 3)
  /// Diastolic for blood pressure; unused otherwise.
  secondary   Decimal?        @db.Decimal(10, 3)
  unit        String
  recordedOn  DateTime        @db.Date
  note        String?         @db.VarChar(500)
  createdAt   DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, recordedOn])
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  prompt    String?
  body      String   @db.VarChar(5000)
  mood      Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// -------------------------------------------------------------- motivation --

enum QuoteCategory {
  DAILY
  STREAK
  COMEBACK
  MILESTONE
  FUNNY
  ENCOURAGEMENT
}

model Quote {
  id       String        @id @default(cuid())
  text     String        @unique @db.VarChar(240)
  category QuoteCategory

  /// Retired quotes stay for the impression history that references them, but
  /// are never picked again. Admins disable rather than delete.
  isActive Boolean @default(true)

  /// Optional targeting. `tone` reuses the share-card personalities so one
  /// vocabulary covers both; `milestoneDays` marks a line that only makes sense
  /// at a particular streak length.
  tone          ShareTone?
  milestoneDays Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  impressions QuoteImpression[]

  @@index([category])
  @@index([isActive, category])
}

/// One row per user per day keeps the daily quote stable and non-repeating.
model QuoteImpression {
  id      String   @id @default(cuid())
  userId  String
  quoteId String
  shownOn DateTime @db.Date

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([userId, shownOn])
  @@index([userId, quoteId])
}

enum AchievementKind {
  STREAK
  TOTAL_DAYS
  METHOD_VARIETY
  EARLY_BIRD
  MONTH_DAYS
  RECIPES_SAVED
  FIRST_ENTRY
}

model Achievement {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  description String
  kind        AchievementKind
  threshold   Int
  tier        Int             @default(1)
  sortOrder   Int             @default(0)

  unlocks UserAchievement[]
}

model UserAchievement {
  id            String    @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime  @default(now())
  /// Set once the celebration has been shown, so we only cheer a badge once.
  seenAt        DateTime?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

enum ChallengeStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

model Challenge {
  id           String  @id @default(cuid())
  slug         String  @unique
  title        String
  description  String
  durationDays Int
  sortOrder    Int     @default(0)
  isPremium    Boolean @default(false)
  /// Retired challenges disappear from the catalog but keep their participants.
  isActive     Boolean @default(true)

  participants UserChallenge[]

  @@index([isActive, sortOrder])
}

model UserChallenge {
  id          String          @id @default(cuid())
  userId      String
  challengeId String
  status      ChallengeStatus @default(ACTIVE)
  startedOn   DateTime        @db.Date
  completedAt DateTime?
  createdAt   DateTime        @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([createdAt])
  @@index([completedAt])
}

// ----------------------------------------------------------------- recipes --

enum RecipeCategory {
  DRINKS
  MEALS
  SNACKS
  QUICK_MIXES
}

model Recipe {
  id            String         @id @default(cuid())
  slug          String         @unique
  title         String
  summary       String         @db.VarChar(400)
  category      RecipeCategory
  /// Free-text so "a pinch" and "1/4 tsp" both read naturally.
  cayenneAmount String
  minutes       Int
  difficulty    String         @default("Easy")
  imageUrl      String?
  isSystem      Boolean        @default(true)
  authorId      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  author      User?              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]
  steps       RecipeStep[]
  favorites   RecipeFavorite[]

  @@index([category])
  @@index([authorId])
  @@index([isSystem, createdAt])
}

model RecipeIngredient {
  id        String @id @default(cuid())
  recipeId  String
  text      String
  sortOrder Int    @default(0)

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

model RecipeStep {
  id        String @id @default(cuid())
  recipeId  String
  text      String
  sortOrder Int    @default(0)

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
}

model RecipeFavorite {
  id        String   @id @default(cuid())
  userId    String
  recipeId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([userId])
}

// ---------------------------------------------------------------- comms/PWA --

model NotificationPreference {
  id             String   @id @default(cuid())
  userId         String   @unique
  dailyReminder  Boolean  @default(false)
  streakWarning  Boolean  @default(true)
  milestoneAlert Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One row per daily reminder. A user taking cayenne three times a day gets
/// three rows, each with its own time and label.
model ReminderTime {
  id      String  @id @default(cuid())
  userId  String
  /// Minutes past local midnight, so a timezone change doesn't shift the time.
  minute  Int
  label   String?
  enabled Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, minute])
  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ShareKind {
  HOT_STREAK
  JOURNEY
  ACHIEVEMENT
  CHALLENGE
  PROGRESS
  PEP_TALK
  MONTHLY_RECAP
}

enum ShareTheme {
  SIGNATURE
  ON_FIRE
  FRESH_CAYENNE
  MASCOT
  MINIMAL
  FACEBOOK
  PHOTO
}

/// The personality of a card's headline. Changes words only, never numbers.
enum ShareTone {
  CLEAN
  FUNNY
  MOTIVATIONAL
  PROUD
}

enum ShareSize {
  FACEBOOK
  INSTAGRAM
  STORY
  SQUARE
}

/// A published card: an explicit, opt-in snapshot of the user's own numbers.
///
/// Every column here is public-safe. There is deliberately no column for weight,
/// blood pressure, glucose, body measurements, moods or journal text, so no
/// setting, query parameter or future bug can put private data on a card — the
/// renderer has nowhere to read it from.
model ShareCard {
  id     String     @id @default(cuid())
  userId String
  token  String     @unique
  kind   ShareKind
  theme  ShareTheme
  size   ShareSize
  tone   ShareTone  @default(FUNNY)

  /// Which line the card was published with. `customLine` wins when set.
  lineIndex  Int?
  customLine String? @db.VarChar(120)

  /// Set only when the user attached their own photo to a Journey card.
  photoId String?

  streak         Int
  longestStreak  Int
  totalDays      Int
  consistency    Int
  daysSinceStart Int

  startedOnLabel    String?
  todayLabel        String?
  amountLabel       String?
  methodLabel       String?
  methodIcon        String?
  achievementTitle  String?
  achievementBlurb  String?
  achievementValue  Int?
  challengeTitle    String?
  challengeDay      Int?
  challengeTotal    Int?
  monthLabel        String?
  monthDaysLogged   Int?
  monthDaysTotal    Int?
  monthAchievements Int?
  quoteText         String? @db.VarChar(240)

  /// The toggle state at publish time, so the card re-renders identically.
  showStreak        Boolean @default(true)
  showTotalDays     Boolean @default(true)
  showLongestStreak Boolean @default(true)
  showConsistency   Boolean @default(false)
  showChallenge     Boolean @default(false)
  showAmount        Boolean @default(false)
  showMethod        Boolean @default(false)
  showStartDate     Boolean @default(false)
  showAchievement   Boolean @default(false)
  showQuote         Boolean @default(true)

  createdAt DateTime @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo SharePhoto? @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

/// A photo the user chose to put on a Journey card.
///
/// Nothing in the app produces one of these. It exists only because the user
/// picked an image for a card they were about to post, which is the only way a
/// photo can ever appear on a card. Deleting the user deletes the photo.
model SharePhoto {
  id        String   @id @default(cuid())
  userId    String
  mime      String   @db.VarChar(32)
  width     Int
  height    Int
  bytes     Bytes
  createdAt DateTime @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards ShareCard[]

  @@index([userId, createdAt])
}

/// A line the user wrote themselves, kept so they can reuse a favourite.
model SavedLine {
  id        String   @id @default(cuid())
  userId    String
  text      String   @db.VarChar(120)
  usedAt    DateTime @default(now())
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, text])
  @@index([userId, usedAt])
}

enum ShareEventType {
  STUDIO_OPENED
  TYPE_SELECTED
  TEMPLATE_SELECTED
  IMAGE_GENERATED
  IMAGE_SAVED
  NATIVE_SHARE_CLICKED
  FACEBOOK_SHARE_CLICKED
  CAPTION_COPIED
  WORDING_CHANGED
}

/// Which templates and moments actually drive sharing.
///
/// Records only what happened inside the app. The destination app or site is
/// never captured — the Web Share API does not report it and we do not ask.
model ShareEvent {
  id           String         @id @default(cuid())
  userId       String
  event        ShareEventType
  kind         ShareKind?
  theme        ShareTheme?
  size         ShareSize?
  captionStyle String?
  createdAt    DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([event, createdAt])
}

// ------------------------------------------------------------------- admin --

/// Everything an admin can do that changes somebody else's account or the
/// app's content. Each value is one auditable action.
enum AdminAction {
  GRANT_LIFETIME
  REVOKE_LIFETIME
  DISABLE_ACCOUNT
  ENABLE_ACCOUNT
  FORCE_PASSWORD_RESET
  ROLE_CHANGED
  QUOTE_CREATED
  QUOTE_UPDATED
  QUOTE_DISABLED
  QUOTE_ENABLED
  CHALLENGE_CREATED
  CHALLENGE_UPDATED
  ACHIEVEMENT_UPDATED
  FEEDBACK_UPDATED
}

/// An append-only record of admin activity.
///
/// Email and target email are copied in rather than joined, so the log still
/// reads correctly after an account is deleted — an audit trail that can be
/// erased by deleting a row elsewhere is not an audit trail. `beforeState` and
/// `afterState` are short human-readable summaries ("entitlement=FREE" ->
/// "entitlement=LIFETIME source=COMPLIMENTARY") rather than blobs, so the log
/// is legible without a decoder.
model AdminAuditLog {
  id         String      @id @default(cuid())
  adminId    String?
  adminEmail String
  action     AdminAction

  targetUserId    String?
  targetUserEmail String?
  /// For actions whose target is not a user: a quote id, a challenge slug.
  targetLabel     String? @db.VarChar(120)

  beforeState String? @db.VarChar(400)
  afterState  String? @db.VarChar(400)
  note        String? @db.VarChar(400)

  createdAt DateTime @default(now())

  admin  User? @relation("AdminActor", fields: [adminId], references: [id], onDelete: SetNull)
  target User? @relation("AdminTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([targetUserId, createdAt])
}

enum FeedbackType {
  BUG
  FEATURE
  GENERAL
}

enum FeedbackStatus {
  NEW
  REVIEWING
  PLANNED
  RESOLVED
  CLOSED
}

/// What users tell us, unprompted. Deliberately free of anything the user did
/// not type: no attached measurements, no journal, no diagnostics.
model Feedback {
  id        String         @id @default(cuid())
  userId    String?
  type      FeedbackType
  message   String         @db.VarChar(2000)
  status    FeedbackStatus @default(NEW)
  /// Admin-only working notes. Never shown to the user who wrote the feedback.
  adminNote String?        @db.VarChar(1000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([userId])
}

/// One immutable row per finished UTC day.
///
/// Admin analytics never scan the raw tables across a date range. A past day
/// cannot change, so it is rolled up once, on the first dashboard load that
/// needs it, and read from here forever after. Only the current day is computed
/// live. This is what keeps the dashboard a handful of indexed reads no matter
/// how much history accumulates.
model DailyStat {
  day DateTime @id @db.Date

  signups           Int @default(0)
  activeUsers       Int @default(0)
  entries           Int @default(0)
  shareCards        Int @default(0)
  shareImagesSaved  Int @default(0)
  purchases         Int @default(0)
  challengesStarted Int @default(0)
  challengesDone    Int @default(0)
  recipesCreated    Int @default(0)

  computedAt DateTime @default(now())
}
